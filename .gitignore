# ============================================================
# Aurwell – .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ──────────────────────────────────────────────────
.next/
out/
build/

# ── Testing ──────────────────────────────────────────────────
coverage/

# ── Environment variables ─────────────────────────────────────
# .env.local.example is safe to commit (no real secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ── Firebase ──────────────────────────────────────────────────
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
storage-debug.log
hosting-debug.log

# Firebase service account key — NEVER commit this
*service-account*.json
*serviceAccount*.json

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Debug logs ────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ── OS artifacts ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Certificates / secrets ────────────────────────────────────
*.pem
*.key
*.p12

# ── Vercel ────────────────────────────────────────────────────
.vercel

# ── Misc ──────────────────────────────────────────────────────
*.local
.turbo/