{
  "rules": {
    "loyalty_points": {
      "$clinicId": {
        "$userId": {
          ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'clinic_admin')",
          ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'clinic_admin')"
        }
      }
    },
    "activity_events": {
      "$clinicId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["timestamp"],
        "$eventId": {
          ".validate": "newData.hasChildren(['type', 'timestamp'])"
        }
      }
    }
  }
}
