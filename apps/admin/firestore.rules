rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admin/$(request.auth.uid)) ||
        (request.auth.token.keys().hasAll(['role']) && (request.auth.token.role == 'super_admin' || request.auth.token.role == 'superadmin'))
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (request.auth.token.keys().hasAll(['role']) && (request.auth.token.role == 'clinic_admin' || request.auth.token.role == 'admin')) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role == 'clinic_admin' || getUserData().role == 'admin'))
        )
      );
    }

    function isClinicAdmin(clinicId) {
      return isSuperAdmin() || (
        isAdmin() && (
          request.auth.uid == clinicId ||
          clinicId == 'clinic_' + request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().clinicId == clinicId) ||
          (exists(/databases/$(database)/documents/clinics/$(clinicId)) && get(/databases/$(database)/documents/clinics/$(clinicId)).data.ownerUid == request.auth.uid)
        )
      );
    }

    // ── 1. USERS COLLECTION ────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create, update: if isUser(userId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── 2. SUBDOMAINS COLLECTION (Public Lookup) ───────────────────────
    match /subdomains/{subdomain} {
      allow read: if true; // Publicly readable for subdomain tenant routing
      allow write: if isAdmin();
    }

    // ── 3. CLINICS COLLECTION & SUBCOLLECTIONS ─────────────────────────
    match /clinics/{clinicId} {
      allow read: if true; // Publicly readable for public clinic booking & branded pages
      allow write: if isClinicAdmin(clinicId);

      match /treatments/{treatmentId} {
        allow read: if true; // Publicly readable for patient booking & app
        allow write: if isClinicAdmin(clinicId);
      }

      match /membership_tiers/{tierId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      match /rewards/{rewardId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      match /settings/{settingId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      match /blogs/{blogId} {
        allow read: if true;
        allow write: if isClinicAdmin(clinicId);
      }

      match /banners/{bannerId} {
        allow read: if true;
        allow write: if isClinicAdmin(clinicId);
      }

      match /automated_offers/{offerId} {
        allow read: if true;
        allow write: if isClinicAdmin(clinicId);
      }

      match /notifications/{notificationId} {
        allow read: if isClinicAdmin(clinicId);
        allow write: if isClinicAdmin(clinicId);
      }

      match /doctors/{doctorId} {
        allow read: if true; // Publicly readable for doctor selection in booking
        allow write: if isClinicAdmin(clinicId);
      }

      match /schedules/{scheduleId} {
        allow read: if true; // Publicly readable for opening hours & availability
        allow write: if isClinicAdmin(clinicId);
      }

      match /blocked_slots/{slotId} {
        allow read: if isClinicAdmin(clinicId);
        allow write: if isClinicAdmin(clinicId);
      }

      match /appointments/{appointmentId} {
        allow read: if isClinicAdmin(clinicId) || (isSignedIn() && resource.data.patient.patientId == request.auth.uid);
        allow create: if isClinicAdmin(clinicId) || (isSignedIn() && request.resource.data.patient.patientId == request.auth.uid);
        allow update, delete: if isClinicAdmin(clinicId);
      }

      match /patients/{patientId} {
        allow read: if isClinicAdmin(clinicId) || isUser(patientId);
        allow create, update: if isClinicAdmin(clinicId) || isUser(patientId);
        allow delete: if isClinicAdmin(clinicId);

        match /availed_rewards/{availedRewardId} {
          allow read: if isClinicAdmin(clinicId) || isUser(patientId);
          allow create, update: if isClinicAdmin(clinicId) || isUser(patientId);
          allow delete: if isClinicAdmin(clinicId);
        }
      }

      match /transactions/{transactionId} {
        allow read: if isClinicAdmin(clinicId) || (isSignedIn() && resource.data.userUid == request.auth.uid);
        allow create: if isClinicAdmin(clinicId) || (isSignedIn() && request.resource.data.userUid == request.auth.uid);
        allow update, delete: if isClinicAdmin(clinicId);
      }

      match /orders/{orderId} {
        allow read: if isClinicAdmin(clinicId) || (isSignedIn() && resource.data.userUid == request.auth.uid);
        allow create: if isClinicAdmin(clinicId) || (isSignedIn() && request.resource.data.userUid == request.auth.uid);
        allow update, delete: if isClinicAdmin(clinicId);
      }

      match /active_memberships/{memberId} {
        allow read: if isClinicAdmin(clinicId) || (isSignedIn() && resource.data.userUid == request.auth.uid);
        allow create: if isClinicAdmin(clinicId) || (isSignedIn() && request.resource.data.userUid == request.auth.uid);
        allow update, delete: if isClinicAdmin(clinicId);
      }

      // Secure subcollection fallback: only clinic admin or super admin can access
      match /{subcollection=**} {
        allow read, write: if isClinicAdmin(clinicId);
      }
    }

    // ── 4. REFERRALS COLLECTION ─────────────────────────────────────────
    match /referrals/{referralCode} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isClinicAdmin(request.resource.data.clinicId) || request.auth.uid == request.resource.data.uid);
      allow delete: if isSuperAdmin();
    }

    // ── 5. B2B REFERRALS COLLECTION ─────────────────────────────────────
    match /b2b_referrals/{referralId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isAdmin() || request.auth.uid == request.resource.data.referrerUid);
      allow delete: if isSuperAdmin();
    }

    // ── 6. ADMINS (SUPER ADMIN ACCESS ONLY) ─────────────────────────────
    match /admin/{adminDoc} {
      allow read: if isSignedIn();
      // Super admin creation / deletion is restricted to existing Super Admins
      allow write: if isSuperAdmin();
    }

    // ── 7. DEV INTEGRATION TESTING ──────────────────────────────────────
    match /test_writes/{doc} {
      allow read, write: if isSuperAdmin();
    }
  }
}
