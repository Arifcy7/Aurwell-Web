{
  "rules": {
    "loyalty_points": {
      "$clinicId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $clinicId || 'clinic_' + auth.uid == $clinicId || auth.token.role == 'clinic_admin' || auth.token.role == 'super_admin')",
        "$userId": {
          ".read": "auth != null && (auth.uid == $userId || auth.uid == $clinicId || 'clinic_' + auth.uid == $clinicId || auth.token.role == 'clinic_admin' || auth.token.role == 'super_admin')",
          ".write": "auth != null && (auth.uid == $clinicId || 'clinic_' + auth.uid == $clinicId || auth.token.role == 'clinic_admin' || auth.token.role == 'super_admin')"
        }
      }
    },
    "activity_events": {
      "$clinicId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $clinicId || 'clinic_' + auth.uid == $clinicId || auth.token.role == 'clinic_admin' || auth.token.role == 'super_admin')",
        ".indexOn": ["timestamp"]
      }
    }
  }
}
