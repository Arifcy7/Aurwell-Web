rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnderMaxSize(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    // ── User / Admin Uploaded Assets ────────────────────────────────────
    match /users/{userId}/{folder}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && isUnderMaxSize(5);
      allow delete: if isOwner(userId);
    }

    // Fallback for nested user paths
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && isUnderMaxSize(5);
      allow delete: if isOwner(userId);
    }

    // ── Dedicated Clinic Assets ─────────────────────────────────────────
    match /clinics/{clinicId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isUnderMaxSize(5);
      allow delete: if isSignedIn() && (request.auth.uid == clinicId || clinicId == 'clinic_' + request.auth.uid);
    }

    // ── Public / Shared Assets Folder ───────────────────────────────────
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isUnderMaxSize(5);
      allow delete: if false; // Disallow arbitrary public deletion
    }

    // ── Default Deny ───────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
