rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────────

    // Check if user is authenticated with Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the authenticated user matches a specific UID
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Safely get user profile data from /users/{uid}
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user is a clinic admin via custom claim or Firestore user record
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'clinic_admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'clinic_admin')
      );
    }

    // Check if the user is the authorized admin for the specified clinic
    function isClinicAdmin(clinicId) {
      return isAdmin() && (
        request.auth.uid == clinicId ||
        clinicId == 'clinic_' + request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().clinicId == clinicId) ||
        (exists(/databases/$(database)/documents/clinics/$(clinicId)) && get(/databases/$(database)/documents/clinics/$(clinicId)).data.ownerUid == request.auth.uid)
      );
    }

    // ── 1. USERS COLLECTION ──────────────────────────────────────────────
    // Path: /users/{userId}
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create, update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── 2. CLINICS COLLECTION & SUBCOLLECTIONS ───────────────────────────
    // Path: /clinics/{clinicId}
    match /clinics/{clinicId} {
      // Public / Authenticated read so mobile app patients can view clinic details
      allow read: if isSignedIn();
      // Clinic owner / admin can update branding, stripe settings, info
      allow write: if isClinicAdmin(clinicId);

      // Treatments subcollection
      match /treatments/{treatmentId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      // Membership Tiers subcollection
      match /membership_tiers/{tierId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      // Rewards catalog subcollection
      match /rewards/{rewardId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      // Clinic settings subcollection (e.g. /settings/rewards_ratio)
      match /settings/{settingId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      // Blogs subcollection
      match /blogs/{blogId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      // Banners subcollection
      match /banners/{bannerId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      // Automated offers subcollection
      match /automated_offers/{offerId} {
        allow read: if isSignedIn();
        allow write: if isClinicAdmin(clinicId);
      }

      // Patients subcollection
      match /patients/{patientId} {
        allow read: if isClinicAdmin(clinicId) || isUser(patientId);
        allow create, update: if isClinicAdmin(clinicId) || isUser(patientId);
        allow delete: if isClinicAdmin(clinicId);

        // Availed rewards (coupons redeemed / claimed by patient)
        match /availed_rewards/{availedRewardId} {
          allow read: if isClinicAdmin(clinicId) || isUser(patientId);
          allow create, update: if isClinicAdmin(clinicId) || isUser(patientId);
          allow delete: if isClinicAdmin(clinicId);
        }
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isClinicAdmin(clinicId) || (isSignedIn() && resource.data.userUid == request.auth.uid);
        allow create: if isClinicAdmin(clinicId) || (isSignedIn() && request.resource.data.userUid == request.auth.uid);
        allow update, delete: if isClinicAdmin(clinicId);
      }

      // Active Memberships subcollection
      match /active_memberships/{memberId} {
        allow read: if isClinicAdmin(clinicId) || (isSignedIn() && resource.data.userUid == request.auth.uid);
        allow create: if isClinicAdmin(clinicId) || (isSignedIn() && request.resource.data.userUid == request.auth.uid);
        allow update, delete: if isClinicAdmin(clinicId);
      }
    }

    // ── 3. REFERRALS COLLECTION ──────────────────────────────────────────
    // Path: /referrals/{referralCode}
    match /referrals/{referralCode} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isClinicAdmin(request.resource.data.clinicId) || request.auth.uid == request.resource.data.uid);
      allow delete: if isAdmin();
    }

    // ── 4. B2B REFERRALS COLLECTION ──────────────────────────────────────
    // Path: /b2b_referrals/{referralId}
    match /b2b_referrals/{referralId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isAdmin() || request.auth.uid == request.resource.data.referrerUid);
      allow delete: if isAdmin();
    }

    // ── DEV INTEGRATION TESTING ──────────────────────────────────────────
    match /test_writes/{doc} {
      allow read, write: if isSignedIn();
    }
  }
}
