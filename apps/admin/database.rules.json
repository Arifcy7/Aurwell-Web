{
  "rules": {
    "loyalty_points": {
      "$clinicId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$userId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "activity_events": {
      "$clinicId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["timestamp"]
      }
    }
  }
}
